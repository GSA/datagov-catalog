FLASK_SECRET_KEY=local-dev-secret-key

DATABASE_SERVER=localhost
# defaults to 5434, not 5432/5433, so a local datagov-harvester checkout
# (db on 5432, or 5433 via its `make up`) can run at the same time
DATABASE_PORT=5434
DATABASE_NAME=mydb
DATABASE_USER=myuser
DATABASE_PASSWORD=mypassword
DATABASE_URI=postgresql+psycopg://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_SERVER}:${DATABASE_PORT}/${DATABASE_NAME}
# defaults to 8082, not 8080, so this can run alongside a local
# datagov-harvester checkout (which uses 8080)
PORT=8082
OPENSEARCH_PORT=9201
OPENSEARCH_PERFORMANCE_PORT=9601

OPENSEARCH_HOST=localhost

# this is used by OpenSearchWriter primarily during harvesting
# but in this case, OpenSearchWriter is used to populate test data
# and the expectation is the wildcard. This is only used during testing.
# keep the port in sync with PORT above -- env_file values aren't interpolated.
CATALOG_BASE_URL=http://0.0.0.0:8082

# New Relic
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=
NEW_RELIC_MONITOR_MODE=false
NEW_RELIC_LOG=/var/log/new_relic.log
NEW_RELIC_LOG_LEVEL=info
NEW_RELIC_HOST=gov-collector.newrelic.com

# Sitemaps S3 settings
SITEMAP_AWS_REGION=us-east-1
SITEMAP_AWS_ACCESS_KEY_ID=
SITEMAP_AWS_SECRET_ACCESS_KEY=
SITEMAP_S3_BUCKET=
